
# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

APP_NAME=Infinaut CRM API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==========================================
# DATABASE - AIVEN POSTGRESQL
# ==========================================

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# SQLAlchemy connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared PostgreSQL-backed application limits. Configure gateway limits too
# before exposing the API publicly.
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_PER_EMAIL=10
LOGIN_RATE_WINDOW_SECONDS=900
PUBLIC_LEAD_RATE_LIMIT=10
PUBLIC_LEAD_RATE_WINDOW_SECONDS=600
AUDIT_STREAMS_GLOBAL_LIMIT=10
AUDIT_STREAMS_PER_USER_LIMIT=2

# ==========================================
# CORS CONFIGURATION
# ==========================================

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_LEAD_TEAM_ID=
APP_TIMEZONE=Asia/Kolkata

# ==========================================
# PASSWORD RECOVERY EMAIL (SMTP)
# ==========================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ==========================================
# AI PROVIDER CONFIGURATION
# ==========================================

# Supported: ollama. AI_SERVICES_ENABLED activates the CRM's AI endpoints.
AI_PROVIDER=ollama
AI_SERVICES_ENABLED=false
INFERENCE_SERVICE_URL=
INFERENCE_SERVICE_TOKEN=
INFERENCE_SERVICE_ENABLED=false
INFERENCE_ALLOW_REMOTE_HTTP=false

# General AI settings
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_LOG_USAGE=true

# ==========================================
# Legacy Gemini settings (unused by the Ollama inference provider)
# ==========================================

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# LOCAL OLLAMA
# ==========================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# ==========================================
# CHAT ORCHESTRATION
# ==========================================

# Chat routes are included with the rest of the AI endpoints when AI_SERVICES_ENABLED=true.
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
CHAT_TURN_TIMEOUT_SECONDS=180
MCP_ALLOW_REMOTE_HTTP=false

# ==========================================
# PRIVATE MCP SERVICE
# ==========================================

# Standalone MCP process only. Never add this process to scripts/start.py.
MCP_ENABLED=false
# Set a separate random value (at least 32 bytes); do not reuse JWT_SECRET_KEY.
MCP_SERVICE_TOKEN=
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,your-device.example.com
BACKEND_API_BASE_URL=http://127.0.0.1:8000
MCP_API_TIMEOUT_SECONDS=10

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
